# ---------------------------------------------------------------------------
# AgentLens configuration
# Copy this file to `.env` and fill in the four values marked REQUIRED.
# ---------------------------------------------------------------------------

# REQUIRED. Anthropic API key, used for both the agent under test and the judge.
# Get one at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# SigNoz OTLP ingestion endpoint + key (used to SEND telemetry).
# Cloud: Settings -> Ingestion Settings. Region is one of: us, eu, in
# Self-hosted: use http://localhost:4318 and leave the key blank.
SIGNOZ_INGESTION_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=https://ingest.us.signoz.cloud:443

# SigNoz query API base URL + API key (used to READ telemetry back).
# Cloud: your workspace URL, key from Settings -> Service Accounts -> Keys.
# Self-hosted: use http://localhost:8080 and leave the key blank.
SIGNOZ_API_URL=https://<your-workspace>.us.signoz.cloud
SIGNOZ_API_KEY=

# ---------------------------------------------------------------------------
# Optional tuning
# ---------------------------------------------------------------------------

# Model the agent under test uses.
AGENT_MODEL=claude-sonnet-5

# Model the judge uses. Kept separate so the judge can be held stable while
# the agent's model is varied underneath it.
JUDGE_MODEL=claude-sonnet-5

# Minimum acceptable mean overall score for `npm run gate` to pass (0..1).
AGENTLENS_SCORE_THRESHOLD=0.75

# Maximum acceptable mean total tokens per *successful* task for the gate.
AGENTLENS_TOKENS_PER_SUCCESS_THRESHOLD=12000

# Set to 1 to dump raw SigNoz query API responses while debugging.
AGENTLENS_DEBUG=0
