# ---------------------------------------------------------------------------
# AgentLens configuration
# Copy this file to `.env` and fill in the marked values.
# Run `npm run doctor` to verify each one independently.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# 1. LLM provider  (used by both the agent under test and the judge)
# ---------------------------------------------------------------------------
# All supported providers speak the OpenAI-compatible protocol, so switching is
# an env change only. Pick one:
#
#   groq        FREE, no card.  console.groq.com  -> API Keys
#               Fast, good function calling. Recommended.
#   gemini      FREE tier, no card.  aistudio.google.com/apikey
#   openrouter  Has free models.  openrouter.ai/keys
#   anthropic   Paid (small free grant on new accounts). Strongest judging.
#   ollama      Fully local, no key. Needs a machine that can run the model.
#
LLM_PROVIDER=groq

# Set the key for whichever provider you chose. Only one is needed.
GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=

# Optional: overrides the provider's default models.
# AGENT_MODEL=llama-3.3-70b-versatile
# JUDGE_MODEL=llama-3.3-70b-versatile
# CHEAP_MODEL=llama-3.1-8b-instant

# ---------------------------------------------------------------------------
# 2. SigNoz — sending telemetry (OTLP ingest)
# ---------------------------------------------------------------------------
# Cloud: Settings -> Ingestion Settings. Region is one of: us, eu, in
# Self-hosted: use http://localhost:4318 and leave the key blank.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SIGNOZ_INGESTION_KEY=

# ---------------------------------------------------------------------------
# 3. SigNoz — reading telemetry back (query API)
# ---------------------------------------------------------------------------
# Cloud: your workspace URL, key from Settings -> Service Accounts -> Keys.
# Self-hosted: http://localhost:8080. Reads are authenticated even locally, so
# mint a key under Settings -> Service Accounts -> Keys -> Add Key and set it
# here. The signoz-viewer role is enough; nothing here writes via the API.
SIGNOZ_API_URL=http://localhost:8080
SIGNOZ_API_KEY=

# ---------------------------------------------------------------------------
# 4. Optional tuning
# ---------------------------------------------------------------------------

# Minimum acceptable mean overall score for `npm run gate` to pass (0..1).
AGENTLENS_SCORE_THRESHOLD=0.75

# Maximum acceptable mean total tokens per run for the gate.
AGENTLENS_TOKENS_PER_SUCCESS_THRESHOLD=12000

# Set to 1 to dump raw SigNoz query API responses while debugging.
AGENTLENS_DEBUG=0
