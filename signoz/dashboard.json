{
  "title": "AgentLens — AI Agent Quality",
  "description": "Agent quality as a first-class signal: groundedness, task completion, tool selection and token efficiency, per prompt variant. Panels read the evaluation spans written by agentlens-evaluator.",
  "tags": ["agentlens", "llm", "ai-agent", "quality"],
  "variables": {},
  "layout": [
    { "i": "score-over-time", "x": 0, "y": 0, "w": 6, "h": 4 },
    { "i": "groundedness-over-time", "x": 6, "y": 0, "w": 6, "h": 4 },
    { "i": "mean-score-now", "x": 0, "y": 4, "w": 3, "h": 3 },
    { "i": "groundedness-now", "x": 3, "y": 4, "w": 3, "h": 3 },
    { "i": "failed-runs", "x": 6, "y": 4, "w": 3, "h": 3 },
    { "i": "tokens-per-run", "x": 9, "y": 4, "w": 3, "h": 3 },
    { "i": "failure-modes", "x": 0, "y": 7, "w": 6, "h": 4 },
    { "i": "score-by-task", "x": 6, "y": 7, "w": 6, "h": 4 },
    { "i": "tokens-by-verdict", "x": 0, "y": 11, "w": 6, "h": 4 },
    { "i": "agent-latency", "x": 6, "y": 11, "w": 6, "h": 4 }
  ],
  "widgets": [
    {
      "id": "score-over-time",
      "title": "Mean overall score by variant",
      "description": "The headline quality signal. A prompt or model change that hurts quality shows up here as a step change.",
      "panelTypes": "graph",
      "nullZeroValues": "zero",
      "yAxisUnit": "none",
      "query": {
        "queryType": "builder",
        "promql": [],
        "clickhouse_sql": [],
        "builder": {
          "queryData": [
            {
              "queryName": "A",
              "expression": "A",
              "dataSource": "traces",
              "aggregateOperator": "avg",
              "aggregateAttribute": {
                "key": "agentlens.eval.score.overall",
                "dataType": "float64",
                "type": "tag",
                "isColumn": false
              },
              "filters": {
                "op": "AND",
                "items": [
                  {
                    "key": { "key": "name", "dataType": "string", "type": "tag", "isColumn": true },
                    "op": "=",
                    "value": "evaluate_run support-triage"
                  }
                ]
              },
              "groupBy": [
                { "key": "agentlens.variant", "dataType": "string", "type": "tag", "isColumn": false }
              ],
              "having": [],
              "orderBy": [],
              "legend": "{{agentlens.variant}}",
              "reduceTo": "avg",
              "stepInterval": 60,
              "disabled": false
            }
          ],
          "queryFormulas": []
        }
      }
    },
